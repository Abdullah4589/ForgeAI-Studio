# ---- Backend (FastAPI) ----
# SQLite by default; use postgresql+psycopg://user:pass@host:5432/forge for Postgres.
DATABASE_URL=sqlite:///./storage/forge.db
MODEL_DIRECTORY=./storage/models
LORA_DIRECTORY=./storage/loras
OUTPUT_DIRECTORY=./storage/outputs
DATASET_DIRECTORY=./storage/datasets
# auto | cuda | cpu
DEVICE=auto
# diffusers (real models) | mock (deterministic placeholder images for tests/CI only)
GENERATION_BACKEND=diffusers
# florence (real, Florence-2) | mock (deterministic captions for tests/CI only)
CAPTION_BACKEND=florence
# Download with: python scripts/download_model.py --captioner
CAPTION_MODEL_DIRECTORY=./storage/captioners/florence-2-base
# diffusers (real LoRA training in a worker process) | mock (tests/CI only)
TRAINING_BACKEND=diffusers
TRAINING_DIRECTORY=./storage/training
# Offload idle submodules to CPU on CUDA to save VRAM (slower, lower memory).
ENABLE_CPU_OFFLOAD=false
# Unload the loaded model after this many idle seconds (0 = never auto-unload).
MODEL_IDLE_UNLOAD_SECONDS=600
LOG_LEVEL=INFO
# Max LoRA upload size in megabytes.
MAX_UPLOAD_SIZE_MB=1024
# Max size of each dataset image upload in megabytes.
MAX_IMAGE_UPLOAD_MB=25
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Optional shared secret. When set, every mutating route requires
# Authorization: Bearer <token>. Leave empty on a trusted machine.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# The web UI sends this same value. It is embedded in the browser bundle
# because the page calls the API directly, so treat it as a deployment secret,
# not a per-user login. NEXT_PUBLIC_API_TOKEN overrides it for the UI only;
# if you set that too, it must match API_TOKEN.
API_TOKEN=

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. Leave empty to reuse API_TOKEN from this file during next dev/build.
NEXT_PUBLIC_API_TOKEN=
